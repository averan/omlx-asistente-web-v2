# Copia este archivo como .env y pon tu API key de oMLX:
#   cp .env.example .env
OMLX_API_KEY=sk-omlx-TU-CLAVE-AQUI

# Opcionales (valores por defecto)
# PORT=5174                       # puerto local de la web
# OMLX_URL=http://127.0.0.1:8000  # dónde escucha oMLX
# MAX_TOKENS=1024                 # longitud máxima de cada respuesta
# MAX_CONCURRENT=2                # generaciones simultáneas (el resto espera: "ocupado")
# RATE_PER_MIN=20                 # mensajes por minuto por visitante
# MAX_BODY_MB=25                  # tamaño máximo de un mensaje con adjuntos
# TICKETS_PER_MIN=5               # solicitudes enviadas por minuto por visitante
